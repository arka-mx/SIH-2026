# MongoDB Connection
MONGODB_URI="mongodb://localhost:27017/sih-2026"

# Backend API Base URL
NEXT_PUBLIC_API_URL=""  # same-origin: /api/* routes are served by this Next app
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# MapTiler Cloud Configuration
NEXT_PUBLIC_MAPTILER_KEY="your_maptiler_key_here"
NEXT_PUBLIC_MAPTILER_MAP_ID="your_maptiler_map_id_here"

# Supabase / PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:your_password@your_host:6543/postgres"

# JWT Auth Configuration
JWT_SECRET="your_jwt_secret_key_here"

# Default Demo UI Autofill Credentials
NEXT_PUBLIC_DEFAULT_ADMIN_USERNAME="admin"
NEXT_PUBLIC_DEFAULT_ADMIN_PASSWORD="admin123"
NEXT_PUBLIC_DEFAULT_CITIZEN_NAME="Rajesh Puripanda"
NEXT_PUBLIC_DEFAULT_CITIZEN_LOCATION="NIT Rourkela"
NEXT_PUBLIC_DEFAULT_RESCUER_ID="demo-team-alpha"
NEXT_PUBLIC_DEFAULT_RESCUER_PASSWORD="rescuer123"

# Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_firebase_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket"
NEXT_PUBLIC_FIREBASE_MSG_SENDER_ID="your_firebase_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_firebase_measurement_id"

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY="your_r2_access_key"
R2_SECRET_KEY="your_r2_secret_key"
R2_BUCKET_NAME="your_r2_bucket_name"

# ── Emergency SMS Alert System ──────────────────────────────────────────────
# Backend-only credentials for the SMS gateway (lib/smsProvider.ts). If none are
# set, alerts still fire as in-app notifications and SMS runs in "simulate" mode
# (logged, not sent). Pick ONE provider.
SMS_PROVIDER=""            # "twilio" | "msg91"  (auto-detected if left blank)

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""              # e.g. +14155550123  (or set a Messaging Service below)
TWILIO_MESSAGING_SERVICE_SID=""

# MSG91
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="ALERTS"           # 6-char DLT-approved sender id
MSG91_ROUTE="4"                    # 4 = transactional
MSG91_COUNTRY_CODE="91"            # default for bare national numbers

# Firebase Admin Service Account JSON
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "your_firebase_project_id", "private_key_id": "your_private_key_id", "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n", "client_email": "your_client_email"}'
