# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/momentum

# ── Cloudinary (incident photo storage) ────────────────────────────────────
# Required in production — serverless hosts (Vercel etc.) have an ephemeral,
# read-only filesystem, so `public/uploads` is lost on every deploy/restart.
# Without these, photos fall back to local disk (fine for `next dev` only).
# Dashboard → Product Environment Credentials.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# — or set the three separately instead of CLOUDINARY_URL —
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Optional, defaults to "sih/incidents"
CLOUDINARY_FOLDER=sih/incidents

# ── Google Gemini (AI features) ─────────────────────────────────────────────
# Server-side only. Without it, every AI feature silently no-ops and the
# platform runs on its deterministic logic exactly as before.
#   • AI report enrichment  – reads each SOS's text + photo (summary, severity,
#                             hazards, photo/type match, credibility, language)
#   • AI situation brief    – GET /api/ai/brief, control-room rollup
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
